# Copy to .env and adjust. Never commit .env or any credentials.

# --- PostgreSQL ---------------------------------------------------------
# Matches docker-compose.yml defaults; change the password for anything shared.
DATABASE_URL=postgresql+psycopg://po_user:CHANGE_ME@localhost:5432/po_demo
# Used by pytest (a separate database, wiped by the tests)
TEST_DATABASE_URL=postgresql+psycopg://po_user:CHANGE_ME@localhost:5432/po_demo_test

# --- Temporal -------------------------------------------------------------
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=po-email-processing
# Temporal Cloud: either an API key or mTLS cert/key paths
TEMPORAL_API_KEY=
TEMPORAL_TLS_CERT_PATH=
TEMPORAL_TLS_KEY_PATH=

# --- Email provider -------------------------------------------------------
# local = .eml files dropped into LOCAL_INBOX_DIR (demo); gmail = Gmail API
EMAIL_PROVIDER=local
LOCAL_INBOX_DIR=./sample_data/inbox
LOCAL_PROCESSED_DIR=./var/processed_emails
POLL_INTERVAL_SECONDS=15

# Gmail (only when EMAIL_PROVIDER=gmail). Files live outside git (see .gitignore).
GMAIL_CREDENTIALS_FILE=./secrets/gmail_credentials.json
GMAIL_TOKEN_FILE=./secrets/gmail_token.json
GMAIL_USER_ID=me
GMAIL_QUERY=is:unread has:attachment filename:pdf -label:po-processed
GMAIL_PROCESSED_LABEL=po-processed

# --- Document processing --------------------------------------------------
# docling (default) | pdfplumber (fallback when Docling models can't be downloaded)
DOCUMENT_PARSER=docling
# Enable OCR for scanned PDFs (downloads extra OCR models on first use)
DOCLING_DO_OCR=false
# How to read ambiguous numeric dates such as 03/04/2026: MDY or DMY
DATE_ORDER=MDY
STORAGE_DIR=./var/storage

LOG_LEVEL=INFO
